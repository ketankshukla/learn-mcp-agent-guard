# Copy to .env.local (which is gitignored) and fill in.
#
# .env.local is read by:
#   - Next.js automatically, for `npm run dev` / `npm run build`
#   - the terminal scripts, via `tsx --env-file-if-exists=.env.local`
#
# ⚠️ .env.local is read ONCE, at process startup. Add a variable and the
# already-running dev server will not see it. Restart it, and confirm Next
# prints `- Environments: .env.local` on boot.

# ---------------------------------------------------------------------------
# REQUIRED — the model.
#
# Read ONLY inside route handlers and terminal scripts, both of which run
# server-side. If this string ever reaches a client component it is compiled
# into the browser bundle and is, at that moment, a stolen key.
# Get one at https://platform.claude.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# REQUIRED — the notebook. A Neon Postgres connection string.
#
# Provision it through the Vercel Marketplace:
#     npx vercel install neon
#     npx vercel env pull .env.local
#
# ...or paste a connection string from https://console.neon.tech.
# It looks like:
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Use the POOLED host (the one with `-pooler`). This app talks to Postgres over
# HTTP with @neondatabase/serverless, so every request is its own connection —
# an ordinary `pg` Pool would exhaust the database's connection slots.
#
# Also server-side only. A database URL in a browser bundle is a public
# database.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# OPTIONAL — lock the door on this repo's own MCP server.
#
# Set this and app/api/jar/route.ts starts demanding
# `Authorization: Bearer <token>` and returns 401 without it. The host reads
# the same value and sends it. Leave it unset and that server runs open, so a
# fresh clone works with no setup.
# Generate one with:  node -e "console.log(crypto.randomUUID())"
# ---------------------------------------------------------------------------
# MCP_SHARED_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL — point the host at different MCP servers. Defaults in lib/servers.ts.
# ---------------------------------------------------------------------------
# JAR_MCP_URL=http://localhost:3000/api/jar
# LEGACY_MCP_URL=https://learn-mcp-5-year-old.vercel.app/api/mcp

# ---------------------------------------------------------------------------
# OPTIONAL — this host calls its own /api/jar over HTTP, so it needs to know
# its own public URL.
#
# ⚠️ On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL, NOT
# VERCEL_URL. VERCEL_URL is the per-deployment hostname and Deployment
# Protection answers it with a 401 — see lib/servers.ts. Set this only to
# override.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
